/* ERREUR : Caractères mal formés */

char c1, c2, c3, c4;

void testErrors() {
    /* ERREUR : caractère non fermé */
    c1 = 'a;
    
    /* ERREUR : caractère vide */
    c2 = '';
    
    /* ERREUR : plusieurs caractères */
    c3 = 'ab';
    
    /* ERREUR : échappement invalide */
    c4 = '\x';
}

int main() {
    return 0;
}
