/* ERREUR : Parenthèses manquantes */

int x, y;

/* ERREUR : parenthèse fermante manquante */
void func1(int a, int b {
    x = a + b;
}

/* ERREUR : parenthèse ouvrante manquante */
void func2int c) {
    x = c;
}

void func3() {
    /* ERREUR : parenthèses manquantes dans if */
    if x > 0 {
        y = 1;
    }
    
    /* ERREUR : parenthèses manquantes dans while */
    while y < 10 {
        y = y + 1;
    }
    
    /* ERREUR : parenthèse manquante dans expression */
    x = (5 + 3 * 2;
}

/* ERREUR : parenthèses manquantes dans appel de fonction */
int main {
    func1(1, 2);
    return 0;
}
