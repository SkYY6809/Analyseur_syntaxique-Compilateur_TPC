/* Test d'affectation de structures */

struct point {
    int x;
    int y;
};

struct vector {
    int dx;
    int dy;
};

struct point p1, p2, p3;
struct vector v1, v2;

void testStructAssignment() {
    p1.x = 10;
    p1.y = 20;
    
    /* Affectation de structure complète */
    p2 = p1;
    p3 = p2;
}

void testMultipleAssignments() {
    v1.dx = 5;
    v1.dy = 3;
    
    v2 = v1;
    
    /* Affectation dans une expression */
    if (v1.dx > 0) {
        v2 = v1;
    } else {
        v1 = v2;
    }
}

int main() {
    testStructAssignment();
    testMultipleAssignments();
    return p2.x + v2.dx;
}
