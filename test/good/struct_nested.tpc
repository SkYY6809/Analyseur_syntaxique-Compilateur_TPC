/* Test des structures imbriquées */

struct engine {
    int power;
    char type;
};

struct wheel {
    int diameter;
    char brand;
};

struct aircraft {
    int height, width;
    struct engine motor;
    struct wheel front_wheel;
};

struct building {
    int floors;
    struct aircraft hangar_plane;
};

/* Variables globales avec structures imbriquées */
struct aircraft plane1, plane2;
struct building tower;

void initAircraft() {
    plane1.height = 100;
    plane1.width = 50;
    plane1.motor.power = 500;
    plane1.motor.type = 'J';
    plane1.front_wheel.diameter = 20;
    plane1.front_wheel.brand = 'M';
}

void initBuilding() {
    tower.floors = 10;
    tower.hangar_plane.height = 80;
    tower.hangar_plane.motor.power = 300;
}

int main() {
    initAircraft();
    initBuilding();
    return 0;
}
